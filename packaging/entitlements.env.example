# Build entitlements — copy to `entitlements.env` and fill in.
#
# `entitlements.env` is git-ignored on purpose: it decides what a released
# binary is bound to, and that decision should live with whoever cuts the
# release, not in the repo.
#
#   cp packaging/entitlements.env.example packaging/entitlements.env
#   ./packaging/build.sh

# The central every binary from this build talks to. Baked into
# sqreader/build_config.py at compile time, so it cannot be edited out of a
# shipped artifact. Scheme matters: it is pinned along with the host.
CENTRAL_URL=https://squadreader.com

# Set to 0 to compile an UNLOCKED binary (internal/staging builds that must be
# able to point at a test platform). Anything else locks it.
LOCKED=1
